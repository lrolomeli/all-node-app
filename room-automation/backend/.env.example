# Copia a .env y ajusta los valores.
PORT=3000

# Secreto de sesión. Usa una cadena larga y aleatoria en producción.
SESSION_SECRET=change_me_to_a_long_random_string
# "true" solo si sirves por HTTPS.
COOKIE_SECURE=false

# Credenciales de acceso al panel/API protegida.
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# ESP32 (emisor IR + sensores).
ESP_HOST=192.168.100.239
ESP_PORT=80

# Zona horaria para las automatizaciones.
CLIMATE_TZ=America/Mexico_City
